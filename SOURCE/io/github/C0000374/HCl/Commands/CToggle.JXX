package io.github.C0000374.HCl.Commands;

#include <HCL.INC>

import io.github.C0000374.HCl.BSE$CMDOBJ;
import io.github.C0000374.HCl.BSE$MODOBJ;
import io.github.C0000374.HCl.CClient;

public final class CToggle extends BSE$CMDOBJ {
    
    public CClient ClientInstance;
    
    public
    CToggle(
        IN CClient ClientInstance
        )
    {
        super("Toggle");
        this.ClientInstance = ClientInstance;
        return;
    }
    
    @Override
    public
    void
    Execute(
        IN String[] Arguments,
        IN String Command
        )
    {
        BSE$MODOBJ Module;
        
        if (Arguments.length != 2) ClientInstance.BSE$InvalidCommand(Command);
        else {
            Module = ClientInstance.BSE$GetModule(Arguments[1]);
            if (Module == null) ClientInstance.BSE$InvalidCommand(Command);
            else ClientInstance.BSE$ToggleModule(Module);
        }
        return;
    }
}
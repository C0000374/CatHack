package io.github.C0000374.CatHack;

#include <CATHACK.INC>

import io.github.C0000374.CatHack.Commands.CBind;
import io.github.C0000374.CatHack.Commands.CToggle;
import io.github.C0000374.CatHack.Modules.Combat.CAutoEat;
import io.github.C0000374.CatHack.Modules.Movement.CWalkOnLiquid;
import io.github.C0000374.CatHack.Modules.Player.CNoFallDamage;
import io.github.C0000374.CatHack.Modules.Render.CFullBright;
import io.github.C0000374.CatHack.Modules.World.CInstantMine;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.util.HashMap;
import java.util.Iterator;
import net.minecraft.client.Minecraft;
import net.minecraft.src.CompressedStreamTools;
import net.minecraft.src.NBTTagByte;
import net.minecraft.src.NBTTagCompound;
import net.minecraft.src.NBTTagInt;

public final class CClient {
    
    public static final String Version = VERSION; // For .JAVA files.
    public static Minecraft BSE$MinecraftInstance;
    public static CClient BSE$ClientInstance;
    public HashMap<String, BSE$MODOBJ> BSE$Modules = new HashMap<>();
    public HashMap<String, BSE$CMDOBJ> BSE$Commands = new HashMap<>();
    
    public
    CClient(
        IN Minecraft MinecraftInstance
        )
    //++
    //
    // Routine Description:
    //     This function:
    //         * initializes the CClient fields.
    //         * registers the modules.
    //         * loads the client configuration
    //
    // Parameters:
    //     MinecraftInstance - A reference to the M.C. main class.
    //
    // Return Value:
    //     None.
    //
    //--
    {
        File ConfigurationFile;
        NBTTagCompound ClientConfigurationCompoundTag;
        NBTTagCompound ModulesCompoundTag;
        Iterator<BSE$MODOBJ> i;
        BSE$MODOBJ Module;
        
        BSE$MinecraftInstance = MinecraftInstance;
        BSE$ClientInstance = this;
        
        //+
        // Register commands and modules.
        //-
        
        this.BSE$RegisterCommand(new CBind(this));
        this.BSE$RegisterCommand(new CToggle(this));
        
        this.BSE$RegisterModule(new CAutoEat(MinecraftInstance));
        this.BSE$RegisterModule(new CFullBright(MinecraftInstance));
        this.BSE$RegisterModule(new CInstantMine());
        this.BSE$RegisterModule(new CNoFallDamage());
        this.BSE$RegisterModule(new CWalkOnLiquid());
        
        //+
        // Load the client configuration from the NBT.
        //-
        ConfigurationFile = new File(Minecraft.getMinecraftDir(), "NBT$CH_C.GZ");
        if (ConfigurationFile.exists()) {
            
            try {
                ClientConfigurationCompoundTag = CompressedStreamTools.loadGzippedCompoundFromOutputStream(new FileInputStream(ConfigurationFile));
            }
            catch (Exception e) {
                e.printStackTrace();
                ClientConfigurationCompoundTag = new NBTTagCompound();
            }
            
            //+
            // Read the modules configuration.
            //-
            
            if (ClientConfigurationCompoundTag.hasKey("Modules") && (ClientConfigurationCompoundTag.GetTag("Modules") instanceof NBTTagCompound)) {
                
                ModulesCompoundTag = ClientConfigurationCompoundTag.getCompoundTag("Modules");
                i = this.BSE$Modules.values().iterator();
                while (i.hasNext()) {
                    
                    Module = i.next();
                    if (ModulesCompoundTag.hasKey(Module.Id) && (ModulesCompoundTag.GetTag(Module.Id) instanceof NBTTagCompound))
                        this.BSE$ReadModuleFromNbt(Module, ModulesCompoundTag.getCompoundTag(Module.Id));
                }
            }
        }
        return;
    }
    
    public
    void
    CAT$WriteConfiguration(
        )
    //++
    //
    // Routine Description:
    //     This routine writes the client configuration to the NBT$CH_C.GZ file.
    //
    // Parameters:
    //     None.
    //
    // Return Value:
    //     None.
    //
    //--
    {
        NBTTagCompound ClientConfigurationCompoundTag;
        NBTTagCompound ModulesCompoundTag;
        NBTTagCompound ModuleCompoundTag;
        Iterator<BSE$MODOBJ> i;
        BSE$MODOBJ Module;
        
        ClientConfigurationCompoundTag = new NBTTagCompound();
        
        //+
        // Write the modules configuration.
        //-
        
        ModulesCompoundTag = new NBTTagCompound();
        
        i = this.BSE$Modules.values().iterator();
        while (i.hasNext()) {
            
            Module = i.next();
            ModuleCompoundTag = new NBTTagCompound();
            this.BSE$WriteModuleToNbt(Module, ModuleCompoundTag);
            ModulesCompoundTag.setCompoundTag(Module.Id, ModuleCompoundTag);
        }
        
        ClientConfigurationCompoundTag.setCompoundTag("Modules", ModulesCompoundTag);
        
        //+
        // Write the NBT data to the NBT$CH_C.GZ file.
        //-
        
        try {
            CompressedStreamTools.writeGzippedCompoundToOutputStream(
                ClientConfigurationCompoundTag,
                new FileOutputStream(new File(Minecraft.getMinecraftDir(), "NBT$CH_C.GZ"))
            );
        }
        catch (Exception e) {
            e.printStackTrace();
        }
        return;
    }
    
    //++
    //
    // API for CMD.
    //
    //--
    
    public
    void
    BSE$RegisterCommand(
        IN BSE$CMDOBJ Command
        )
    {
        this.BSE$Commands.put(Command.Id.toUpperCase(), Command);
        return;
    }
    
    public
    BSE$CMDOBJ
    BSE$GetCommand(
        IN String Id
        )
    {
        return this.BSE$Commands.get(Id.toUpperCase());
    }
    
    public
    void
    BSE$ExecuteCommand(
        IN String Command
        )
    {
        String[] Arguments;
        BSE$CMDOBJ CommandHandler;
        
        Arguments = Command.split(" ");
        if (Arguments.length > 0) {
            
            CommandHandler = BSE$GetCommand(Arguments[0]);
            if (CommandHandler == null) this.BSE$InvalidCommand(Command);
            else CommandHandler.Execute(Arguments, Command);
        }
        return;
    }
    
    public
    void
    BSE$InvalidCommand(
        IN String Command
        )
    {
        BSE$MinecraftInstance.ingameGUI.addChatMessage("%CATHACK-E-INVCMD, Invalid command \"" + Command + "\".");
        return;
    }
    
    //++
    //
    // API for modules.
    //
    //--
    
    public
    void
    BSE$RegisterModule(
        IN BSE$MODOBJ Module
        )
    {
        this.BSE$Modules.put(Module.Id.toUpperCase(), Module);
        return;
    }
    
    public
    BSE$MODOBJ
    BSE$GetModule(
        IN String ModuleId
        )
    {
        return this.BSE$Modules.get(ModuleId.toUpperCase());
    }
    
    public
    void
    BSE$ToggleModule(
        IN BSE$MODOBJ Module
        )
    {
        Module.IsActive = !Module.IsActive;
        if (Module.IsActive) {
            Module.HandleEvent(ME$ENABLE, null, null);
            BSE$MinecraftInstance.ingameGUI.addChatMessage("%CATHACK-I-TOGGLE, " + Module.Id + " was enabled.");
        }
        else {
            Module.HandleEvent(ME$DISABLE, null, null);
            BSE$MinecraftInstance.ingameGUI.addChatMessage("%CATHACK-I-TOGGLE, " + Module.Id + " was disabled.");
        }
        return;
    }
    
    public
    void
    BSE$SendEvent(
        IN int EventId,
        IN OUT Object ParameterW OPTIONAL,
        IN OUT Object ParameterL OPTIONAL
        )
    {
        Iterator<BSE$MODOBJ> i;
        BSE$MODOBJ Module;
        
        i = this.BSE$Modules.values().iterator();
        while (i.hasNext()) {
            Module = i.next();
            if (Module.IsActive && (Module.EventsMask & ME$_BIT(EventId)) != 0)
                Module.HandleEvent(EventId, ParameterW, ParameterL);
        }
        return;
    }
    
    public
    void
    BSE$WriteModuleToNbt(
        IN BSE$MODOBJ Module,
        OUT NBTTagCompound CompoundTag
        )
    {
        NBTTagCompound SettingsCompoundTag;
        Iterator<BSE$STGOBJ> i;
        
        CompoundTag.setBoolean("IsActive", Module.IsActive);
        CompoundTag.setInteger("KeyBinding", Module.KeyBinding);
        
        SettingsCompoundTag = new NBTTagCompound();
        i = Module.Settings.values().iterator();
        while (i.hasNext()) i.next().WriteToNbt(SettingsCompoundTag);
        CompoundTag.setCompoundTag("Settings", SettingsCompoundTag);
        return;
    }
    
    public
    void
    BSE$ReadModuleFromNbt(
        OUT BSE$MODOBJ Module,
        IN NBTTagCompound CompoundTag
        )
    {
        NBTTagCompound SettingsCompoundTag;
        Iterator<BSE$STGOBJ> i;
        
        if (CompoundTag.hasKey("IsActive") && (CompoundTag.GetTag("IsActive") instanceof NBTTagByte))
            Module.IsActive = CompoundTag.getBoolean("IsActive");
        
        if (CompoundTag.hasKey("KeyBinding") && (CompoundTag.GetTag("KeyBinding") instanceof NBTTagInt))
            Module.KeyBinding = CompoundTag.getInteger("KeyBinding");
        
        if (CompoundTag.hasKey("Settings") && (CompoundTag.GetTag("Settings") instanceof NBTTagCompound)) {
            
            SettingsCompoundTag = CompoundTag.getCompoundTag("Settings");
            i = Module.Settings.values().iterator();
            while (i.hasNext()) i.next().ReadFromNbt(SettingsCompoundTag);
        }
        return;
    }
    
    public
    void
    BSE$RegisterModuleSetting(
        IN BSE$MODOBJ Module,
        IN BSE$STGOBJ Setting
        )
    {
        Module.Settings.put(Setting.Id.toUpperCase(), Setting);
        return;
    }
    
    public
    BSE$STGOBJ
    BSE$GetModuleSetting(
        IN BSE$MODOBJ Module,
        IN String SettingId
        )
    {
        return Module.Settings.get(SettingId.toUpperCase());
    }
    
    //++
    //
    // UI
    //
    //--
    
    public
    void
    UI$HandleKeyEvent(
        IN int Key
        )
    {
        Iterator<BSE$MODOBJ> i;
        BSE$MODOBJ Module;
        
        i = this.BSE$Modules.values().iterator();
        while (i.hasNext()) {
            Module = i.next();
            if (Module.KeyBinding == Key) this.BSE$ToggleModule(Module);
        }
        return;
    }
}
package io.github.C0000374.CatHack;

#include <CATHACK.INC>

import net.minecraft.src.NBTTagCompound;

public abstract class BSE$STGOBJ {
    
    public String Id;
    
    public
    BSE$STGOBJ(
        String Id
        )
    {
        this.Id = Id;
        return;
    }
    
    public
    abstract
    void
    WriteToNbt(
        OUT NBTTagCompound CompoundTag
        );
        
    public
    abstract
    void
    ReadFromNbt(
        IN NBTTagCompound CompoundTag
        );
}
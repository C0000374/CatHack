package io.github.C0000374.CatHack;

#include <CATHACK.INC>

import java.util.HashMap;

public abstract class BSE$MODOBJ {
    
    public String Id;
    public boolean IsActive = false;
    public int KeyBinding;
    public HashMap<String, BSE$STGOBJ> Settings = new HashMap<>();
    public long EventsMask;
    
    public
    BSE$MODOBJ(
        IN String Id,
        IN long EventsMask
        )
    {
        this.Id = Id;
        this.EventsMask = EventsMask;
        return;
    }
    
    public
    void
    HandleEvent(
        IN int EventId,
        IN OUT Object ParameterW OPTIONAL,
        IN OUT Object ParameterL OPTIONAL
        )
    {
        return;
    }
}
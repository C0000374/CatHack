package io.github.C0000374.CatHack;

#include <CATHACK.INC>

public abstract class BSE$CMDOBJ {
    
    public String Id;
    
    public
    BSE$CMDOBJ(
        IN String Id
        )
    {
        this.Id = Id;
        return;
    }
    
    public
    abstract
    void
    Execute(
        IN String[] Arguments,
        IN String Command
        );
}
package io.github.C0000374.CatHack.Modules;

#include <CATHACK.INC>

import io.github.C0000374.CatHack.BSE$MODOBJ;
import org.lwjgl.input.Keyboard;

public final class CNoFallDamage extends BSE$MODOBJ {
    
    public static CNoFallDamage Instance;
    
    public
    CNoFallDamage(
        )
    {
        super("NoFallDamage", Keyboard.KEY_NONE, 0);
        Instance = this;
    }
}
package io.github.C0000374.CatHack.Modules;

#include <CATHACK.INC>

import io.github.C0000374.CatHack.BSE$MODOBJ;
import net.minecraft.client.Minecraft;
import org.lwjgl.input.Keyboard;

public final class CFullBright extends BSE$MODOBJ {
    
    public static CFullBright Instance;
    public Minecraft MinecraftInstance;
    
    public
    CFullBright(
        IN Minecraft MinecraftInstance
        )
    {
        super("FullBright", Keyboard.KEY_NONE, ME$_BIT(ME$ENABLE) | ME$_BIT(ME$DISABLE));
        this.MinecraftInstance = MinecraftInstance;
        Instance = this;
        return;
    }
    
    @Override
    public
    void
    HandleEvent(
        IN int EventId,
        IN OUT Object ParameterW OPTIONAL,
        IN OUT Object ParameterL OPTIONAL
        )
    {
        int X;
        int Z;
        
        //+
        // Mark ALL blocks dirty.
        //-
        
        if (this.MinecraftInstance.thePlayer != null) {
            X = (int)this.MinecraftInstance.thePlayer.posX;
            Z = (int)this.MinecraftInstance.thePlayer.posZ;
            this.MinecraftInstance.theWorld.markBlocksDirty(
                X - 0x400,
                0x00,
                Z - 0x400,
                X + 0x400,
                0x80,
                Z + 0x400
            );
        }
        return;
    }
}
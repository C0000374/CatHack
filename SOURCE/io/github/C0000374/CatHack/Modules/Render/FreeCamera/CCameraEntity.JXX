package io.github.C0000374.CatHack.Modules.Render.FreeCamera;

#include <CATHACK.INC>

import net.minecraft.client.Minecraft;
import net.minecraft.src.EntityLiving;
import net.minecraft.src.MovementInput;

public final class CCameraEntity extends EntityLiving {
    
    public Minecraft MinecraftInstance;
    public MovementInput MovInput;
    
    public
    CCameraEntity(
        )
    #define cce$mc CFreeCamera.Instance.MinecraftInstance
    {     
        super(cce$mc.theWorld);
        
        this.MinecraftInstance = cce$mc;
        
        this.noClip = true;
        this.yOffset = 1.62F;
        this.posX = this.prevPosX = this.lastTickPosX = this.MinecraftInstance.thePlayer.posX;
        this.posY = this.prevPosY = this.lastTickPosY = this.MinecraftInstance.thePlayer.posY;
        this.posZ = this.prevPosZ = this.lastTickPosZ = this.MinecraftInstance.thePlayer.posZ;
        this.setPosition(this.posX, this.posY, this.posZ);
        this.rotationYaw = this.prevRotationYaw = this.MinecraftInstance.thePlayer.rotationYaw;
        this.rotationPitch = this.prevRotationPitch = this.MinecraftInstance.thePlayer.rotationPitch;
        this.MovInput = this.MinecraftInstance.thePlayer.movementInput;
        return;
    }
    #undef cce$mc
    
    public
    void
    Update(
        )
    {
        this.prevRotationYaw = this.rotationYaw;
        this.prevRotationPitch = this.rotationPitch;
        this.prevPosX = this.posX;
        this.prevPosY = this.posY;
        this.prevPosZ = this.posZ;
        this.lastTickPosX = this.posX;
        this.lastTickPosY = this.posY;
        this.lastTickPosZ = this.posZ;
        this.moveFlying(this.MovInput.moveStrafe, this.MovInput.moveForward, 0.16F);
        this.motionY = this.MovInput.MoveY;
        this.moveEntity(this.motionX, this.motionY, this.motionZ);
        this.motionX *= 0.91F;
        this.motionY = 0.0F;
        this.motionZ *= 0.91F;
        return;
    }
}
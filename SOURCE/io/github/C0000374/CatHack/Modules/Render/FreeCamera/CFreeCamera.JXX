package io.github.C0000374.CatHack.Modules.Render.FreeCamera;

#include <CATHACK.INC>

import net.minecraft.client.Minecraft;
import io.github.C0000374.CatHack.BSE$MODOBJ;

public final class CFreeCamera extends BSE$MODOBJ {
    
    public static CFreeCamera Instance;
    public Minecraft MinecraftInstance;
    
    public
    CFreeCamera(
        IN Minecraft MinecraftInstance
        )
    {
        super("FreeCamera", ME$_BIT(ME$ENABLE) | ME$_BIT(ME$DISABLE) | ME$_BIT(ME$PLAYER_UPDATE_POST));
        this.MinecraftInstance = MinecraftInstance;
        Instance = this;
        return;
    }
    
    @Override
    public
    void
    HandleEvent(
        IN int EventId,
        IN OUT Object ParameterW OPTIONAL,
        IN OUT Object ParameterL OPTIONAL
        )
    {
        switch (EventId) {
        case ME$ENABLE:
            this.MinecraftInstance.renderViewEntity = new CCameraEntity();
            break;
            
        case ME$DISABLE:
            this.MinecraftInstance.renderViewEntity = this.MinecraftInstance.thePlayer;
            break;
            
        case ME$PLAYER_UPDATE_POST:
            if (this.MinecraftInstance.renderViewEntity instanceof CCameraEntity) ((CCameraEntity)this.MinecraftInstance.renderViewEntity).Update();
            break;
        }
        return;
    }
}